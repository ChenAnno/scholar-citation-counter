{
  "manifest_version": 3,
  "name": "Scholar Rocket",
  "version": "1.7",
  "description": "A minimalist Chrome extension that tracks your Google Scholar citation count and highlights newly cited papers.",
  "permissions": ["storage", "alarms"],
  "host_permissions": [
    "https://scholar.google.com/*",
    "https://scholar.google.com.hk/*",
    "https://www.google.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": "icons/rocket.png"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
